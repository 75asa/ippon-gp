{
  /* IPPON GP — Realtime Database セキュリティルール（M1 最小形）
     設計意図・守れること / 守れないこと・デプロイ手順は docs/SECURITY_RULES.md を参照。
     スキーマは docs/ARCHITECTURE.md §3（ルート直下フラット）に対応する。
     すべてのクライアントは未認証（auth == null）で動く前提。 */
  "rules": {
    ".read": true,

    "mode": {
      ".write": "newData.exists()",
      ".validate": "newData.isString() && newData.val().matches(/^(taiki|odai|saiten|scoreboard|agenda)$/)"
    },

    "taiki": {
      ".write": true,
      ".validate": "newData.val() === true"
    },

    "odai": {
      /* 上限は settings/odaiCount（お題数、#18）。無ければ 6（素材が 1..6 の 6 問分までのため） */
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= (root.child('settings/odaiCount').exists() ? root.child('settings/odaiCount').val() : 6)"
    },

    "votes": {
      /* ノードごと削除（HOST の resetVotes / モード切替）は許可。中身の一括書き込みは $seat の検証を通る */
      ".write": "!newData.exists()",
      "$seat": {
        /* 新規作成のみ。既存票の上書き・個別削除は不可。
           席は settings/judges にある席だけ（設定が無ければ従来どおり 1..10） */
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$seat.matches(/^([1-9]|10)$/) && newData.val() === true && (!root.child('settings/judges').exists() || root.child('settings/judges').hasChild($seat))"
      }
    },

    "seats": {
      /* 審査員の座席ロック（#25）。seats/{seat} = { device, at }。1 席を持てるのは 1 台だけ。
         ノードごとの削除（設定画面が消えた席を片付ける）と、各席の削除（戻る・onDisconnect・長押しの引き継ぎ）は誰でもできる */
      ".write": "!newData.exists()",
      "$seat": {
        /* 空席を取る / 自分の席を取り直す / 外す。他の端末の席の上書きは、from に今の持ち主を入れた引き継ぎ（長押し）だけ */
        ".write": "!newData.exists() || !data.exists() || data.child('device').val() === newData.child('device').val() || newData.child('from').val() === data.child('device').val()",
        ".validate": "$seat.matches(/^([1-9]|10)$/) && newData.hasChildren(['device', 'at']) && (!root.child('settings/judges').exists() || root.child('settings/judges').hasChild($seat))",
        "device": { ".validate": "newData.isString() && newData.val().matches(/^d[a-z0-9]{8,32}$/)" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "from": { ".validate": "newData.isString() && newData.val().matches(/^d[a-z0-9]{8,32}$/)" },
        "$other": { ".validate": false }
      }
    },

    "settings": {
      /* 設定画面（web/admin/）が書く。形は web/src/shared/judges.js と揃える */
      "judges": {
        /* 席の追加・削除・並べ替え・初期値に戻す（ノードごとの置き換え / 削除）は、票が入っていないときだけ */
        ".write": "!root.child('votes').exists()",
        /* 席は 1 からの連番（最大 10）。定員は IPPON に必要な票数（settings/ipponThreshold、無ければ 6）以上 */
        ".validate": "newData.hasChild('1') && (!newData.hasChild('2') || newData.hasChild('1')) && (!newData.hasChild('3') || newData.hasChild('2')) && (!newData.hasChild('4') || newData.hasChild('3')) && (!newData.hasChild('5') || newData.hasChild('4')) && (!newData.hasChild('6') || newData.hasChild('5')) && (!newData.hasChild('7') || newData.hasChild('6')) && (!newData.hasChild('8') || newData.hasChild('7')) && (!newData.hasChild('9') || newData.hasChild('8')) && (!newData.hasChild('10') || newData.hasChild('9')) && (root.child('settings/ipponThreshold').exists() || newData.hasChild('6')) && (root.child('settings/ipponThreshold').val() != 1 || newData.hasChild('1')) && (root.child('settings/ipponThreshold').val() != 2 || newData.hasChild('2')) && (root.child('settings/ipponThreshold').val() != 3 || newData.hasChild('3')) && (root.child('settings/ipponThreshold').val() != 4 || newData.hasChild('4')) && (root.child('settings/ipponThreshold').val() != 5 || newData.hasChild('5')) && (root.child('settings/ipponThreshold').val() != 6 || newData.hasChild('6')) && (root.child('settings/ipponThreshold').val() != 7 || newData.hasChild('7')) && (root.child('settings/ipponThreshold').val() != 8 || newData.hasChild('8')) && (root.child('settings/ipponThreshold').val() != 9 || newData.hasChild('9')) && (root.child('settings/ipponThreshold').val() != 10 || newData.hasChild('10'))",
        "$seat": {
          ".validate": "$seat.matches(/^([1-9]|10)$/) && newData.hasChildren(['name', 'kind'])",
          /* 既にある席の名前・種別は投票中でも変えられる（席番号は変わらないので票はずれない） */
          "name": {
            ".write": "data.exists() && newData.exists()",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().beginsWith('　') && !newData.val().endsWith('　')"
          },
          "kind": {
            ".write": "data.exists() && newData.exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(panel|venue)$/)"
          },
          "$other": { ".validate": false }
        }
      },
      "ipponThreshold": {
        /* IPPON に必要な票数。票が入っていないときだけ変えられる。
           削除（初期値 6 に戻す）は、審査員の定員が 6 以上（または初期値の 10 席）のときだけ */
        ".write": "!root.child('votes').exists() && (newData.exists() || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('6'))",
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10 && (newData.val() != 1 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('1')) && (newData.val() != 2 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('2')) && (newData.val() != 3 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('3')) && (newData.val() != 4 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('4')) && (newData.val() != 5 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('5')) && (newData.val() != 6 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('6')) && (newData.val() != 7 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('7')) && (newData.val() != 8 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('8')) && (newData.val() != 9 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('9')) && (newData.val() != 10 || !root.child('settings/judges').exists() || root.child('settings/judges').hasChild('10'))"
      },
      "odaiCount": {
        /* お題数（#18）。HOST の問1..N ボタン・読み上げボタンと MAIN の odai_1..N 表示の上限。
           素材が 1..6 の 6 問分までなので 1〜6 の整数のみ。無ければ 6 */
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6"
      },
      "playerCount": {
        /* 回答者数（#18）。HOST のスコア欄と MAIN のスコアボードに出す人数（回答者 1..N）。
           顔写真・scores が 5 人分までなので 2〜5 の整数のみ。無ければ 5。scores は常に 5 要素のまま */
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 2 && newData.val() <= 5"
      },
      "players": {
        /* 回答者の名前（キーは回答者番号 1..5 = portrait_playerN = scores[N-1]）。採点に影響しないので投票中でも変えられる */
        ".write": true,
        ".validate": "newData.hasChildren(['1', '2', '3', '4', '5'])",
        "$n": {
          ".validate": "$n.matches(/^[1-5]$/) && newData.hasChild('last')",
          "last": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().beginsWith('　') && !newData.val().endsWith('　')" },
          "first": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().beginsWith('　') && !newData.val().endsWith('　')" },
          "$other": { ".validate": false }
        }
      },
      "$other": {
        ".write": false,
        ".validate": false
      }
    },

    "revealed": {
      ".write": true,
      ".validate": "newData.isBoolean()"
    },

    "scores": {
      /* 削除不可。要素 5 個ちょうどの 0..99 整数配列（RTDB 上は '0'..'4' キー）のみ */
      ".write": "newData.exists()",
      ".validate": "newData.hasChildren(['0', '1', '2', '3', '4'])",
      "$i": {
        ".validate": "$i.matches(/^[0-4]$/) && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 99"
      }
    },

    "agenda": {
      ".write": true,
      ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https?:\\/\\/[^ ]+$/)"
    },

    "answer_text": {
      ".write": true,
      ".validate": "newData.isString() && newData.val().length <= 2000"
    },

    "keep_audio": {
      ".write": true,
      ".validate": "newData.val() === true"
    },

    "se_master": {
      ".write": true,
      ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)"
    },

    "se_trigger": {
      ".write": "newData.exists()",
      ".validate": "newData.hasChildren(['key', 'action', 'ts'])",
      "key":    { ".validate": "newData.isString() && newData.val().matches(/^(laugh_[1-4]|se_cheer|se_clap)$/)" },
      "action": { ".validate": "newData.isString() && newData.val().matches(/^(play|stop)$/)" },
      "ts":     { ".validate": "newData.isNumber() && newData.val() > 0" },
      "$other": { ".validate": false }
    },

    "camera_room": {
      ".write": true,
      ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
    },

    "clients": {
      /* 各画面の簡易ステータス公開（#26。今のところ MAIN の素材読み込み状況のみ）。
         2 つ MAIN タブが開いている場合は最後に書いた方が勝つ（last-writer-wins）。
         MAIN が閉じる／リロードされると onDisconnect().remove() で消える（共有ノードなので、
         もう 1 つの MAIN タブがまだ生きていても消えてしまう点は許容する） */
      "main": {
        ".write": true,
        ".validate": "newData.hasChildren(['loaded', 'total', 'ts'])",
        "loaded":      { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999" },
        "total":       { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999" },
        "failedCount": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999" },
        /* 失敗した素材の短いパス一覧。最大 10 件（$i は 1 桁のみ = 添字 0..9）。実際の失敗件数は failedCount */
        "failed": {
          "$i": { ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 100" }
        },
        "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      },
      "$other": { ".write": false, ".validate": false }
    },

    "camera_quality": {
      /* 配信品質の要約（#63）。MAIN が受信側の getStats() から低頻度（変化時、または前回の書き込みから
         10 秒経った heartbeat のときだけ・5 秒間隔目安）で書く。ts はサーバー時刻（{'.sv':'timestamp'}）
         で書くので、HOST は MAIN との時計のズレに関係なく古さ（配信切れ）を判定できる。
         HOST がここを見て「CAM: 1080p 4.2Mbps」のように表示する。
         削除は、MAIN の disconnectCamera() / 接続断（connectionstatechange）/ camera_room 消失 / onDisconnect
         のいずれでも起きる。値を残さず消せるよう常に許可 */
      ".write": true,
      ".validate": "newData.hasChildren(['res', 'fps', 'kbps', 'codec', 'limit', 'path', 'ts'])",
      "res":   { ".validate": "newData.isString() && newData.val().matches(/^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}$/)" },
      "fps":   { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 240" },
      "kbps":  { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
      "codec": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,16}$/)" },
      "limit": { ".validate": "newData.isString() && newData.val().matches(/^(none|bandwidth|cpu|other)$/)" },
      "path":  { ".validate": "newData.isString() && newData.val().matches(/^(host|nat|unknown)$/)" },
      "ts":    { ".validate": "newData.isNumber() && newData.val() > 0" },
      "$other": { ".validate": false }
    },

    /* 上記以外のトップレベルキーは一切書けない（ルートに .write が無いので既定で拒否だが、意図を明示） */
    "$other": {
      ".write": false,
      ".validate": false
    }
  }
}

rules_version = '2';
// Firebase Storage のルール。素材（画像・音声・動画）は各画面が認証なしで読むので公開読み取り。
// 書き込みは誰にも許可しない（素材の追加は scripts/migrate-storage.mjs / コンソール / gcloud で行う。
// 設定画面からのアップロード（#34）を入れるときに、認証とセットで見直す）。
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
